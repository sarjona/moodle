{{!
    @template core_courseformat/local/linearnavigation/footer_content

    The course linear navigation footer content.

    Example context (json):
    {
        "previousurl": "http://moodle.com/course/cms/1/previous",
        "nexturl": "http://moodle.com/course/cms/1/next"
    }
}}
<div class="course-linear-navigation-footer-content d-flex justify-content-between w-100">
    <a href="{{previousurl}}" class="course-linear-navigation-link d-inline-flex align-items-center gap-2">
        <span class="dir-rtl-hide" aria-hidden="true">{{#pix}}e/backward, core{{/pix}}</span>
        <span class="dir-ltr-hide" aria-hidden="true">{{#pix}}e/forward, core{{/pix}}</span>
        <span>{{#str}} previous, core {{/str}}</span>
    </a>
    <a href="{{nexturl}}" class="course-linear-navigation-link d-inline-flex align-items-center gap-2">
        <span>{{#str}} next, core {{/str}}</span>
        <span class="dir-rtl-hide" aria-hidden="true">{{#pix}}e/forward, core{{/pix}}</span>
        <span class="dir-ltr-hide" aria-hidden="true">{{#pix}}e/backward, core{{/pix}}</span>
    </a>
</div>
