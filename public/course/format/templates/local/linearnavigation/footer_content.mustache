{{!
    @template core_courseformat/local/linearnavigation/footer_content

    The course linear navigation footer content.

    Example context (json):
    {
        "previousbutton": {
            "url": "http://moodle.com/course/cms/12/previous",
            "label": "Previous"
        },
        "nextbutton": {
            "url": "http://moodle.com/course/cms/12/next",
            "label": "Next"
        }
    }
}}
<div class="course-linear-navigation-footer-content d-flex w-100 justify-content-between align-items-center">
    <a href="{{{previousbutton.url}}}" class="btn btn-link text-decoration-none px-0" data-action="previous-activity">
        <span class="me-1" aria-hidden="true">&larr;</span>{{previousbutton.label}}
    </a>
    <a href="{{{nextbutton.url}}}" class="btn btn-link text-decoration-none px-0" data-action="next-activity">
        {{nextbutton.label}}<span class="ms-1" aria-hidden="true">&rarr;</span>
    </a>
</div>
