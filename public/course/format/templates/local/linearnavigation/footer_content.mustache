{{!
    @template core_courseformat/local/linearnavigation/footer_content

    The course linear navigation footer content.

    Example context (json):
    {
        "previousbutton": {
            "id": "button1",
            "method": "get",
            "url": "http://moodle.com/course/cms/12/previous",
            "label": "Previous",
            "actions": []
        },
        "nextbutton": {
            "id": "button2",
            "method": "get",
            "url": "http://moodle.com/course/cms/12/next",
            "label": "Next",
            "actions": []
        }
    }
}}
<div class="course-linear-navigation-footer-content mt-3 d-flex justify-content-between">
    {{#previousbutton}}{{> core/single_button}}{{/previousbutton}}
    {{#nextbutton}}{{> core/single_button}}{{/nextbutton}}
</div>
