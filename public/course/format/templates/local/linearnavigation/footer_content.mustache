{{!
    @template core_courseformat/local/linearnavigation/footer_content

    The course linear navigation footer content.

    Example context (json):
    {
        "prevlink": {
            "id": "prev-activity-link",
            "url": "http://moodle.com/course/cms/10/previous",
            "text": "Previous"
        },
        "nextlink": {
            "id": "next-activity-link",
            "url": "http://moodle.com/course/cms/10/next",
            "text": "Next"
        }
    }
}}
<div class="course-linear-navigation-footer-content d-flex align-items-center justify-content-between w-100 mt-3">
    <div class="course-linear-navigation-footer-content-prev">
        {{#prevlink}}{{> core/action_link }}{{/prevlink}}
    </div>
    <div class="course-linear-navigation-footer-content-next">
        {{#nextlink}}{{> core/action_link }}{{/nextlink}}
    </div>
</div>
